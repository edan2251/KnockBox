# 줄바꿈은 저장소 기준 LF로 통일 (Windows 작업 시 Git이 자동 변환)
* text=auto

*.cs      text diff=csharp
*.md      text
*.json    text
*.asmdef  text
*.uss     text
*.uxml    text

# Unity YAML 직렬화 파일
*.unity   text eol=lf
*.prefab  text eol=lf
*.asset   text eol=lf
*.meta    text eol=lf
*.mat     text eol=lf
*.anim    text eol=lf
*.controller text eol=lf
*.inputactions text eol=lf

# 바이너리
*.png binary
*.jpg binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.fbx binary
